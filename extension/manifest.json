{
  "manifest_version": 3,
  "name": "Freelancer Bid Bot",
  "description": "Opens a Freelancer project, writes a tailored bid with your AI key, types it like a human, and submits.",
  "version": "0.2.2",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bid Bot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.freelancer.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.freelancer.com/*",
        "https://*.freelancer.com/*",
        "https://contracts.freelancer.com/*",
        "https://*.hellosign.com/*",
        "https://*.dropbox.com/*",
        "https://*.dropboxsign.com/*",
        "https://app.hellosign.com/*",
        "https://embedded.hellosign.com/*",
        "https://cdn.hellosign.com/*",
        "https://sign.dropbox.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
