PORT=8787

# Password for the dashboard login page. Leave empty to keep the dashboard open (not recommended online).
DASHBOARD_PASSWORD=

# Shared secret every extension worker sends (x-worker-token header).
WORKER_TOKEN=

# A dispatched task with no result after this long is re-queued, up to MAX_ATTEMPTS total tries.
TASK_TIMEOUT_MS=300000
MAX_ATTEMPTS=2

# Persistent storage (required on Vercel; without it tasks are kept in memory).
# Adding the Upstash Redis integration on Vercel sets these (or the KV_REST_API_* equivalents) automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
